# Supabase Project URL & Anon Key (Vercel Project Settings > Environment Variables)
VITE_SUPABASE_URL=https://kkqxdvytjcwqiditkqay.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_CK-mobqkhFkJeksELv-H1Q_s35ZLTCD

# Google OAuth Client ID
VITE_GOOGLE_CLIENT_ID=637980227155-clcfso2b4jl9lmp3rp907d59uttavjp6.apps.googleusercontent.com

# Naver Papago Translation API (NMT)
NAVER_PAPAGO_CLIENT_ID=your_papago_client_id_here
NAVER_PAPAGO_CLIENT_SECRET=your_papago_client_secret_here

# 快递100 (Kuaidi100) 택배 조회 API
KUAIDI100_KEY=your_kuaidi100_key_here
KUAIDI100_CUSTOMER=your_kuaidi100_customer_here
KUAIDI100_SECRET=your_kuaidi100_secret_here
KUAIDI100_USERID=your_kuaidi100_userid_here

# ���� ���� ų����ġ (false=��Ȱ��/��ŵ, true=Ȱ��/���İ� ȣ��)
VITE_TRANSLATION_ENABLED=true
TRANSLATION_ENABLED=true

# Server-side shared translation cache (translation_cache table). Server-only flag, no VITE_ prefix.
# false/unset = cache fully bypassed, Papago called directly (safe default).
TRANSLATION_CACHE_ENABLED=false

# 1688 official cross-border multilingual API as the Korean source (free, country="ko").
# Fills translation_cache so the existing translate flow hits cache instead of Papago.
# Server-only flags. Both default to ON; set to "false" to roll back.
#   CROSSBORDER_KO_ENABLED=false       -> disables both search and detail enrichment (default: ON)
#   CROSSBORDER_KO_SEARCH_ENABLED=true -> enables the search path (default: OFF)
#     Measured 2026-09-22: item_search and keywordQuery return nearly disjoint result
#     sets (title match 60% / 5% / 0% on three live runs), so the search path doubles
#     OneBound calls for little gain. Detail path is unaffected and stays ON.
CROSSBORDER_KO_ENABLED=true
CROSSBORDER_KO_SEARCH_ENABLED=false

# Papago fallback for cache misses. Server-only flag. Default ON.
# Set to "false" to verify how the site behaves with Papago fully off (originals shown).
PAPAGO_FALLBACK_ENABLED=true
