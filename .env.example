# ==============================================================================
# EUC COMPANY - 배포 환경변수 설정 템플릿 (.env.example)
# Vercel / Netlify / Cloudflare Pages 배포 시 Environment Variables에 등록하세요.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase 공개 연결 설정 (Supabase 대시보드 -> Project Settings -> API)
# ------------------------------------------------------------------------------
# [필수] Supabase 프로젝트 URL (공개 가능)
VITE_SUPABASE_URL=https://kkqxdvytjcwqiditkqay.supabase.co

# [필수] Supabase anon (public publishable) Key (공개 가능)
# 주의: service_role 키는 절대 VITE_ 접두어로 프론트엔드에 넣지 마세요!
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here


# ------------------------------------------------------------------------------
# 2. 네이버(Naver) OAuth2 로그인 연동 (Naver Developers Console)
# ------------------------------------------------------------------------------
# [필수] 네이버 애플리케이션 Client ID
VITE_NAVER_CLIENT_ID=UnBL7sON2_LO_noLE03c

# [로컬 개발 환경용] 개발 서버용 Client Secret
VITE_NAVER_CLIENT_SECRET=z16G9iuU30

# [필수] 네이버 로그인 Callback URL
# 로컬 개발 시: http://localhost:5173/auth/callback/naver
# 운영 배포 시: https://your-domain.com/auth/callback/naver (Naver Developers에도 동일하게 등록)
VITE_NAVER_REDIRECT_URI=https://your-domain.com/auth/callback/naver


# ------------------------------------------------------------------------------
# 3. 1688 DataHub (RapidAPI) & DeepL API 연동
# ------------------------------------------------------------------------------
RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_HOST=1688-datahub.p.rapidapi.com
VITE_RAPIDAPI_KEY=your_rapidapi_key_here
VITE_RAPIDAPI_HOST=1688-datahub.p.rapidapi.com

DEEPL_API_KEY=your_deepl_api_key_here
VITE_DEEPL_API_KEY=your_deepl_api_key_here
